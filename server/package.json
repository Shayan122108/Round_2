{
  "name": "ml-challenge-server",
  "version": "2.0.0",
  "description": "Secure API, queue and trusted scorer for the ML Challenge platform",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "worker": "tsx --env-file=../.env src/worker.ts",
    "start": "node --env-file=../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=../.env prisma/seed.ts",
    "sandbox:build": "docker build -t mlc-sandbox:1 ./sandbox"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.5.0",
    "pino": "9.14.0",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
