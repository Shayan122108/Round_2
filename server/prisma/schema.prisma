// PostgreSQL is the single source of truth for identity, verifications, results and scores.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ADMIN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CompetitionStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  ENDED
}

/// Participants and Admins
model User {
  id             String   @id @default(uuid())
  /// Unique sequential web_id automatically generated by PostgreSQL sequence (never count+1)
  webId          Int      @unique @default(autoincrement())
  registrationId String   @unique
  displayName    String
  role           Role     @default(PARTICIPANT)
  pinHash        String?
  teamId         String?

  /// Assigned model variant (1..4) based on 4k mapping rule
  variantId      Int?
  variant        Variant? @relation(fields: [variantId], references: [id])

  /// Total score across all 3 rounds (0..150)
  totalScore     Int      @default(0)
  lastScoreAt    DateTime?

  /// Round 1: Linear Regression (30 pts)
  round1Status          String    @default("IN_PROGRESS") // IN_PROGRESS, PENDING_VERIFICATION, APPROVED, REJECTED
  round1Points          Int       @default(0)
  round1ApprovedAt      DateTime?
  round1ApprovedBy      String?
  round1RejectionReason String?

  /// Round 2: Decode the Model Anagram (50 pts)
  round2Status          String    @default("LOCKED") // LOCKED, IN_PROGRESS, SOLVED
  round2Points          Int       @default(0)
  round2SolvedAt        DateTime?
  round2Attempts        Int       @default(0)

  /// Round 3: Assigned ML Model Challenge (70 pts)
  round3Status               String    @default("LOCKED") // LOCKED, AWAITING_RELEASE, READY, PENDING_VERIFICATION, APPROVED, REJECTED
  round3BoilerplateReleased  Boolean   @default(false)
  round3BoilerplateReleasedAt DateTime?
  round3BoilerplateReleasedBy String?
  round3Points               Int       @default(0)
  round3ApprovedAt           DateTime?
  round3ApprovedBy           String?
  round3RejectionReason      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team      Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sessions  Session[]
  decisions DecisionHistory[]

  @@index([teamId])
  @@index([totalScore(sort: Desc), lastScoreAt])
  @@index([round1Status])
  @@index([round3Status])
}

model Variant {
  /// Internal variant id (1..4). Never exposed to participants.
  id              Int     @id
  label           String
  hiddenModel     String
  shuffledLetters String
  /// Name of the sklearn final-estimator class
  estimator       String
  starterTemplate String
  /// Reference metrics for Round 3 manual verification (admin-only)
  round3Mae       Float   @default(0.85)
  round3Rmse      Float   @default(1.20)
  round3Mse       Float   @default(1.44)
  enabled         Boolean @default(true)

  users           User[]
  teams           Team[]
}

model BenchmarkConfig {
  id         Int      @id @default(1)
  round1Mae  Float    @default(1.25)
  round1Rmse Float    @default(1.85)
  round1Mse  Float    @default(3.42)
  updatedAt  DateTime @updatedAt
  updatedBy  String?
}

model DecisionHistory {
  id         String   @id @default(uuid())
  userId     String
  round      Int      // 1 or 3
  action     String   // APPROVE or REJECT
  points     Int
  reason     String?
  adminId    String
  adminName  String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Team {
  id              String   @id @default(uuid())
  name            String   @unique
  variantId       Int
  scoreAdjustment Int     @default(0)
  createdAt       DateTime @default(now())

  variant     Variant           @relation(fields: [variantId], references: [id])
  members     User[]
  submissions Submission[]
  completions StageCompletion[]
  attempts    AnagramAttempt[]
  progress    TeamProgress?

  @@index([variantId])
}

model TeamProgress {
  teamId             String   @id
  stage1Points       Int      @default(0)
  anagramPoints      Int      @default(0)
  stage2Points       Int      @default(0)
  incorrectAttempts  Int      @default(0)
  stage1QualifiedAt  DateTime?
  anagramSolvedAt    DateTime?
  stage2QualifiedAt  DateTime?
  totalScore         Int      @default(0)
  lastScoreAt        DateTime?
  updatedAt          DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([totalScore(sort: Desc), lastScoreAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Submission {
  id             String           @id @default(uuid())
  teamId         String
  submittedById  String
  stage          Int
  artifactPath   String
  artifactName   String
  sha256         String
  sizeBytes      Int
  status         SubmissionStatus @default(QUEUED)
  idempotencyKey String?
  attempts       Int              @default(0)
  queuedAt       DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  enqueuedAt     DateTime?
  adminNote      String?

  team   Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  result EvaluationResult?

  @@unique([teamId, idempotencyKey])
  @@index([teamId, queuedAt])
  @@index([status, queuedAt])
}

model EvaluationResult {
  submissionId String   @id
  accuracy     Float?
  precision    Float?
  recall       Float?
  f1           Float?
  qualified    Boolean  @default(false)
  rowsScored   Int?
  durationMs   Int?
  errorCode    String?
  /// Organizer-only holdout evaluation metrics (tested against test_for_admin.csv). Never exposed to participants.
  adminMetrics Json?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model StageCompletion {
  id           String   @id @default(uuid())
  teamId       String
  milestone    Int
  submissionId String?
  points       Int
  completedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, milestone])
}

model AnagramAttempt {
  id             String   @id @default(uuid())
  teamId         String
  userId         String
  guess          String
  correct        Boolean
  penaltyApplied Int      @default(0)
  createdAt      DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

model CompetitionConfig {
  id                   Int               @id @default(1)
  status               CompetitionStatus @default(RUNNING)
  durationSeconds      Int               @default(3600)
  startedAt            DateTime?
  endsAt               DateTime?
  remainingSeconds     Int?
  stage1Points         Int               @default(30)
  anagramPoints        Int               @default(50)
  stage2Points         Int               @default(70)
  anagramPenalty       Int               @default(0)
  maxScore             Int               @default(150)
  updatedAt            DateTime          @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorName String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
