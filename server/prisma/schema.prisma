// PostgreSQL is the single source of truth for identity, submissions, results and scores.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ADMIN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CompetitionStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  ENDED
}

/// Participants are grouped into teams; the team is the scoring unit.
model User {
  id             String   @id @default(uuid())
  registrationId String   @unique
  displayName    String
  role           Role     @default(PARTICIPANT)
  pinHash        String
  teamId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team     Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sessions Session[]

  @@index([teamId])
}

model Variant {
  /// Internal variant id (1..4). Never exposed to participants.
  id             Int     @id
  label          String
  hiddenModel    String
  shuffledLetters String
  /// Name of the sklearn final-estimator class Stage 2 artifacts must use.
  estimator      String
  stage1MinAccuracy Float  @default(0.75)
  stage2MinAccuracy Float
  stage2MinMacroF1  Float
  starterTemplate String
  enabled        Boolean @default(true)

  teams Team[]
}

model Team {
  id             String   @id @default(uuid())
  name           String   @unique
  variantId      Int
  /// Admin-adjustable correction applied on top of computed score (audited).
  scoreAdjustment Int     @default(0)
  createdAt      DateTime @default(now())

  variant     Variant           @relation(fields: [variantId], references: [id])
  members     User[]
  submissions Submission[]
  completions StageCompletion[]
  attempts    AnagramAttempt[]
  progress    TeamProgress?

  @@index([variantId])
}

/// One row per team; guarded with SELECT ... FOR UPDATE for atomic scoring.
model TeamProgress {
  teamId             String   @id
  stage1Points       Int      @default(0)
  anagramPoints      Int      @default(0)
  stage2Points       Int      @default(0)
  incorrectAttempts  Int      @default(0)
  stage1QualifiedAt  DateTime?
  anagramSolvedAt    DateTime?
  stage2QualifiedAt  DateTime?
  /// Authoritative cached total, clamped to 0..150.
  totalScore         Int      @default(0)
  lastScoreAt        DateTime?
  updatedAt          DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([totalScore(sort: Desc), lastScoreAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Submission {
  id             String           @id @default(uuid())
  teamId         String
  submittedById  String
  stage          Int
  artifactPath   String
  artifactName   String
  sha256         String
  sizeBytes      Int
  status         SubmissionStatus @default(QUEUED)
  idempotencyKey String?
  attempts       Int              @default(0)
  queuedAt       DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  enqueuedAt     DateTime?
  adminNote      String?

  team   Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  result EvaluationResult?

  @@unique([teamId, idempotencyKey])
  @@index([teamId, queuedAt])
  @@index([status, queuedAt])
}

model EvaluationResult {
  submissionId String   @id
  accuracy     Float?
  precision    Float?
  recall       Float?
  f1           Float?
  qualified    Boolean  @default(false)
  rowsScored   Int?
  durationMs   Int?
  /// Safe, participant-visible machine code, e.g. TIMEOUT, FEATURE_MISMATCH.
  errorCode    String?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

/// Unique (team, stage) guarantees a milestone is awarded at most once.
model StageCompletion {
  id           String   @id @default(uuid())
  teamId       String
  /// 1 = stage 1, 2 = anagram, 3 = stage 2
  milestone    Int
  submissionId String?
  points       Int
  completedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, milestone])
}

model AnagramAttempt {
  id             String   @id @default(uuid())
  teamId         String
  userId         String
  guess          String
  correct        Boolean
  penaltyApplied Int      @default(0)
  createdAt      DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

/// Singleton row (id = 1).
model CompetitionConfig {
  id                   Int               @id @default(1)
  status               CompetitionStatus @default(NOT_STARTED)
  durationSeconds      Int               @default(5400)
  startedAt            DateTime?
  /// Wall-clock end while RUNNING; null otherwise.
  endsAt               DateTime?
  /// Remaining seconds frozen at pause time.
  remainingSeconds     Int?
  stage1Points         Int               @default(30)
  anagramPoints        Int               @default(50)
  stage2Points         Int               @default(70)
  anagramPenalty       Int               @default(30)
  maxScore             Int               @default(150)
  updatedAt            DateTime          @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
