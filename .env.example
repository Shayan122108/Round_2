# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development

# --- PostgreSQL (docker-compose defaults; change for any shared/production host) ---
POSTGRES_USER=mlc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlchallenge
POSTGRES_PORT=55432
DATABASE_URL=postgresql://mlc:change-me@127.0.0.1:55432/mlchallenge?schema=public

# --- Redis / BullMQ ---
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379

# --- API ---
PORT=5000
# Comma separated list of browser origins allowed for CORS + CSRF origin checks
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5000,http://127.0.0.1:3000
# 48+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=replace-with-long-random-string
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# --- Bootstrap admin (used by `npm run db:seed` only) ---
ADMIN_REGISTRATION_ID=ADMIN
ADMIN_PIN=replace-with-strong-pin-8+chars

# --- Storage (relative to server/) ---
STORAGE_DIR=storage

# --- Uploads / queue limits ---
MAX_ARTIFACT_MB=25
MAX_QUEUE_DEPTH=200
SUBMISSIONS_PER_MINUTE_PER_TEAM=3
EVAL_CONCURRENCY=2

# --- Sandbox (docker | local-insecure) ---
# local-insecure runs the model in a plain subprocess; it is REFUSED when NODE_ENV=production
SANDBOX_MODE=docker
SANDBOX_IMAGE=mlc-sandbox:1
SANDBOX_TIMEOUT_SEC=60
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_PIDS=128

# Set to 1 ONLY for rehearsals: allows evaluation data that is known to be public
ALLOW_COMPROMISED_EVAL_DATA=1
